# ==============================================================================
# BSF MONITOR - Environment Configuration Template
# ==============================================================================

# Operation Mode: SIMULATION | PRODUCTION
BSF_MODE=SIMULATION

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security (Change in production!)
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bsf_monitor
POSTGRES_USER=bsf_user
POSTGRES_PASSWORD=bsf_secure_password
DATABASE_URL=postgresql+asyncpg://bsf_user:bsf_secure_password@postgres:5432/bsf_monitor
DATABASE_SYNC_URL=postgresql://bsf_user:bsf_secure_password@postgres:5432/bsf_monitor

# MQTT Telemetry Broker (Mosquitto)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=bsf_backend_service
MQTT_USER=
MQTT_PASSWORD=

# Camera & Multimedia Service
CAMERA_MODE=VIRTUAL
STORAGE_PATH=/app/storage/media
IMAGE_CAPTURE_INTERVAL=300
MEDIA_MAX_FILE_SIZE_MB=50

# Simulation Parameters
SIMULATION_TICK_RATE_SECONDS=5
SIMULATION_NOISE_LEVEL=0.05
SENSOR_POLL_INTERVAL=5
