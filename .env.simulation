# ==============================================================================
# BSF MONITOR - Simulation Mode Configuration (Docker)
# ==============================================================================

BSF_MODE=SIMULATION

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

SECRET_KEY=sim_secret_key_development_only_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bsf_monitor
POSTGRES_USER=bsf_user
POSTGRES_PASSWORD=bsf_sim_password
DATABASE_URL=postgresql+asyncpg://bsf_user:bsf_sim_password@postgres:5432/bsf_monitor
DATABASE_SYNC_URL=postgresql://bsf_user:bsf_sim_password@postgres:5432/bsf_monitor

MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=bsf_sim_backend
MQTT_USER=
MQTT_PASSWORD=

CAMERA_MODE=VIRTUAL
STORAGE_PATH=/app/storage/media
IMAGE_CAPTURE_INTERVAL=300
MEDIA_MAX_FILE_SIZE_MB=50

SIMULATION_TICK_RATE_SECONDS=5
SIMULATION_NOISE_LEVEL=0.05
SENSOR_POLL_INTERVAL=5
